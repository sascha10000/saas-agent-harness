# ── Copy to .env and adjust per project ─────────────────────────────
# Values here configure the autonomous MVP build loop (phase 4) and the
# app scaffold. Never commit a real .env.

# GAN build loop (ecc:gan-build / ecc:orch-build-mvp)
GAN_DEV_SERVER_CMD="cargo watch -q -x run"   # fallback if cargo-watch missing: "cargo run"
GAN_DEV_SERVER_PORT=8080
GAN_EVAL_MODE=playwright
GAN_PASS_THRESHOLD=7.5
GAN_MAX_ITERATIONS=12

# App scaffold
PORT=8080
DATABASE_URL=sqlite://data/app.sqlite        # postgres://... only if STACK.md justifies it

# Stripe (test keys until the launch phase; live keys are a money gate)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Research budget for phases 2-3 (quick | standard | deep)
RESEARCH_DEPTH=standard
